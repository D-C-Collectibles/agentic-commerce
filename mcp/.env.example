# Base URL of the storefront API the agent shops at.
STORE_API_URL=http://127.0.0.1:3000

# Agent grant token authorizing this MCP to act on the user's behalf. Get one by
# signing in to the storefront and calling POST /agent/grant (or the "Authorize an
# agent" button in the SPA). Purchases still require a per-purchase human selfie check.
AGENT_GRANT=
