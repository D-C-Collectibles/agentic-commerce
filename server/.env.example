DATABASE_URL=
PORT=3000

# Secret used to sign session JWTs (#auth-service). Any long random string for the
# demo — e.g. `openssl rand -hex 32`. Required for /auth/* and /checkout.
JWT_SECRET=

# Origin of the storefront SPA, used for CORS. Defaults to allowing all origins if
# unset (fine for local demo). Set to e.g. http://localhost:5173 to lock it down.
CLIENT_ORIGIN=

# How purchases settle (#payment-service). "mock" (default) settles instantly with no
# Circle creds — good for developing the storefront + agent flow. "circle" routes
# through #wallet-service for a real Arc-testnet USDC transfer (needs the CIRCLE_* vars
# and MERCHANT_PAYOUT_ADDRESS below).
PAYMENTS_MODE=mock

# Public base URL used to build the human-facing personhood-verification link in MOCK
# mode (#agent-route / #verify-route). Defaults to http://127.0.0.1:$PORT. Set to a
# tunnel URL (e.g. an ngrok https URL) when the human verifies on a different device.
PUBLIC_BASE_URL=

# Personhood verification for agent purchases (#worldid-service). "mock" (default) uses
# a click-through page; "world" uses the real World ID Selfie Check (requires the WORLD_*
# vars below). In world mode the verification link points at the SPA (APP_BASE_URL).
VERIFICATION_MODE=mock

# Base URL of the storefront SPA, where the World ID Selfie Check page lives in world
# mode. Defaults to http://127.0.0.1:5173.
APP_BASE_URL=

# World ID (https://developer.world.org) — only needed when VERIFICATION_MODE=world.
# WORLD_APP_ID and WORLD_RP_ID are public; WORLD_RP_SIGNING_KEY is SECRET (server-side
# only, plain hex, 0x optional) and signs RP requests. Never expose the signing key.
# Note: the "selfie" (Selfie Check) credential is a gated beta — request access for your
# app from the World team first.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=

# The World ID action for agent purchases — register this identifier in the app's
# Actions section in the Developer Portal. One fixed action is reused for every purchase;
# the specific purchase is bound per-request by the session id (the widget `signal`).
WORLD_ACTION=agentic-commerce-purchase

# Circle Developer-Controlled Wallets (testnet) — only needed when PAYMENTS_MODE=circle.
# Get CIRCLE_API_KEY from https://console.circle.com (API Keys, not Client Keys).
# CIRCLE_ENTITY_SECRET is generated by you — see: pnpm register-entity-secret
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Merchant payout wallet address (Arc testnet) — required when PAYMENTS_MODE=circle.
# Never accepted from the client.
MERCHANT_PAYOUT_ADDRESS=

# Circle wallet account type (#wallet-service). "EOA" (default, unchanged behavior) or
# opt-in "SCA" (Smart Contract Account) — a prerequisite for the on-chain session-key
# follow-up described in .paradigm/specs/wallet-checkout.md "Session-scoped agent
# grants". Setting this alone does not add any on-chain policy.
WALLET_ACCOUNT_TYPE=EOA

# Session-key-style scoped policy for agent grants (#agent-grants-service) — see
# .paradigm/specs/wallet-checkout.md "Session-scoped agent grants". How long the
# per-grant destination/spend-cap policy recorded at POST /agent/grant stays honored,
# independent of the (365d) agent-grant JWT's own lifetime. Defaults to 86400 (24h).
AGENT_GRANT_SESSION_TTL_SECONDS=86400

# Secrets backend (#secrets-service) — see .paradigm/specs/wallet-checkout.md "Secrets
# backend". "env" (default) reads secrets from plain process.env, unchanged from
# today. "ledger-ring" instead shells out to Ledger's `wallet-cli ring decrypt --key
# <name>` to retrieve secrets encrypted at rest under a Ledger device's domain key — no
# device or network prompt needed to *decrypt*, only network access to restore the
# trustchain. Getting there requires a ONE-TIME, device-present, human-with-hardware
# ops step that this repo does not and cannot script:
#   1. `wallet-cli ring init` — provisions the ring; enter the password when prompted,
#      or pipe it from an OS keychain (e.g. `--password "$(security find-generic-password ...)"`
#      / `--password "$(pass show ...)"`) so it's never typed by an agent or committed
#      anywhere.
#   2. For each secret this app needs (JWT_SECRET, CIRCLE_API_KEY,
#      CIRCLE_ENTITY_SECRET, WORLD_RP_SIGNING_KEY, ...):
#      `wallet-cli ring encrypt -i <plaintext-file> -o <name>.enc --key <name>`
# After that one-time setup, `wallet-cli ring decrypt --key <name>` (what
# #secrets-service shells out to) needs no device present, only network access.
SECRETS_BACKEND=env

# Wallet sharding (#wallet-service) — see .paradigm/specs/wallet-checkout.md "Sharding".
# Number of wallet shards users are deterministically partitioned across. Defaults to 1
# (today's single-wallet-set behavior, unchanged). Only raise this once per-shard Circle
# credentials below are provisioned.
SHARD_COUNT=1

# Optional per-shard Circle credentials (N = 0..SHARD_COUNT-1), e.g. CIRCLE_API_KEY_0,
# CIRCLE_API_KEY_1, CIRCLE_ENTITY_SECRET_0, CIRCLE_ENTITY_SECRET_1. A shard without its
# own scoped key/secret falls back to the plain CIRCLE_API_KEY/CIRCLE_ENTITY_SECRET
# above, so this is optional even with SHARD_COUNT > 1.
# CIRCLE_API_KEY_0=
# CIRCLE_ENTITY_SECRET_0=

# Auto-sweep (#wallet-service.sweepShardBalances) — moves any user wallet's USDC balance
# above this threshold into TREASURY_ADDRESS, bounding how much a compromised shard key
# can expose. Unset/non-positive disables sweeping. Not cron-wired (no cron infra in
# this repo) — call sweepShardBalances(shardId) from an ops job once one exists.
SWEEP_THRESHOLD_USDC=
TREASURY_ADDRESS=
