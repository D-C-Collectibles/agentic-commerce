DATABASE_URL=
PORT=3000

# Secret used to sign session JWTs (#auth-service). Any long random string for the
# demo — e.g. `openssl rand -hex 32`. Required for /auth/* and /checkout.
JWT_SECRET=

# Origin of the storefront SPA, used for CORS. Defaults to allowing all origins if
# unset (fine for local demo). Set to e.g. http://localhost:5173 to lock it down.
CLIENT_ORIGIN=

# How purchases settle (#payment-service). "mock" (default) settles instantly with no
# Circle creds — good for developing the storefront + agent flow. "circle" routes
# through #wallet-service for a real Arc-testnet USDC transfer (needs the CIRCLE_* vars
# and MERCHANT_PAYOUT_ADDRESS below).
PAYMENTS_MODE=mock

# Public base URL used to build the human-facing personhood-verification link
# (#agent-route / #verify-route). Defaults to http://127.0.0.1:$PORT. Set to a tunnel
# URL (e.g. an ngrok https URL) when the human verifies on a different device/network.
PUBLIC_BASE_URL=

# Circle Developer-Controlled Wallets (testnet) — only needed when PAYMENTS_MODE=circle.
# Get CIRCLE_API_KEY from https://console.circle.com (API Keys, not Client Keys).
# CIRCLE_ENTITY_SECRET is generated by you — see: pnpm register-entity-secret
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Merchant payout wallet address (Arc testnet) — required when PAYMENTS_MODE=circle.
# Never accepted from the client.
MERCHANT_PAYOUT_ADDRESS=
