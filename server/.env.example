DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/agentic-commerce?sslmode=require
PORT=3000

# Secret used to sign session JWTs (#auth-service). Any long random string for the
# demo — e.g. `openssl rand -hex 32`. Required for /auth/* and /checkout.
JWT_SECRET=

# Origin of the storefront SPA, used for CORS. Defaults to allowing all origins if
# unset (fine for local demo). Set to e.g. http://localhost:5173 to lock it down.
CLIENT_ORIGIN=

# Circle Developer-Controlled Wallets (testnet). Get CIRCLE_API_KEY from
# https://console.circle.com (API Keys, not Client Keys). CIRCLE_ENTITY_SECRET
# is generated by you — see: pnpm register-entity-secret
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Merchant payout wallet address (Arc testnet). Never accepted from the client.
MERCHANT_PAYOUT_ADDRESS=
