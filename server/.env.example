DATABASE_URL=
PORT=3000

# Secret used to sign session JWTs (#auth-service). Any long random string for the
# demo — e.g. `openssl rand -hex 32`. Required for /auth/* and /checkout.
JWT_SECRET=

# Origin of the storefront SPA, used for CORS. Defaults to allowing all origins if
# unset (fine for local demo). Set to e.g. http://localhost:5173 to lock it down.
CLIENT_ORIGIN=

# How purchases settle (#payment-service). "mock" (default) settles instantly with no
# Circle creds — good for developing the storefront + agent flow. "circle" routes
# through #wallet-service for a real Arc-testnet USDC transfer (needs the CIRCLE_* vars
# and MERCHANT_PAYOUT_ADDRESS below).
PAYMENTS_MODE=mock

# Public base URL used to build the human-facing personhood-verification link in MOCK
# mode (#agent-route / #verify-route). Defaults to http://127.0.0.1:$PORT. Set to a
# tunnel URL (e.g. an ngrok https URL) when the human verifies on a different device.
PUBLIC_BASE_URL=

# Personhood verification for agent purchases (#worldid-service). "mock" (default) uses
# a click-through page; "world" uses the real World ID Selfie Check (requires the WORLD_*
# vars below). In world mode the verification link points at the SPA (APP_BASE_URL).
VERIFICATION_MODE=mock

# Base URL of the storefront SPA, where the World ID Selfie Check page lives in world
# mode. Defaults to http://127.0.0.1:5173.
APP_BASE_URL=

# World ID (https://developer.world.org) — only needed when VERIFICATION_MODE=world.
# WORLD_APP_ID and WORLD_RP_ID are public; WORLD_RP_SIGNING_KEY is SECRET (server-side
# only) and is used to sign RP requests. Never expose the signing key to the client.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=

# Circle Developer-Controlled Wallets (testnet) — only needed when PAYMENTS_MODE=circle.
# Get CIRCLE_API_KEY from https://console.circle.com (API Keys, not Client Keys).
# CIRCLE_ENTITY_SECRET is generated by you — see: pnpm register-entity-secret
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Merchant payout wallet address (Arc testnet) — required when PAYMENTS_MODE=circle.
# Never accepted from the client.
MERCHANT_PAYOUT_ADDRESS=
